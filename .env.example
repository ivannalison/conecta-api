# Modelo das variáveis de ambiente da conecta-api.
# Copie para um arquivo .env (que NÃO vai para o GitHub) e preencha.
# Nunca coloque senhas ou a string de conexão real neste arquivo.

# Ambiente: development, test ou production
NODE_ENV=development

# Porta e endereço do servidor (o Cloud Run define PORT sozinho)
PORT=3000
HOST=0.0.0.0

# Nível de log: fatal, error, warn, info, debug, trace ou silent
LOG_LEVEL=info

# MongoDB Atlas (obrigatório)
# Use o usuário de SOMENTE LEITURA da API. O usuário de escrita é só para o seed.
# Formato: mongodb+srv://USUARIO:SENHA@SEU-CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DB_NAME=conecta

# Sites autorizados a chamar a API (CORS), separados por vírgula.
# Em produção, colocar o endereço do front-end no Cloud Run.
CORS_ORIGINS=http://localhost:4200

# Limite de requisições por IP, por minuto
RATE_LIMIT_MAX=100
